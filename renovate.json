{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["NUnit", "NUnitLite", "NUnit3TestAdapter", "NUnit.Analyzers"],
      "groupName": "NUnit ecosystem updates",
      "schedule": ["* 0-8 * * *"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/build-process\\.yml$/"
      ],
      "matchStrings": [
        "NUNIT_VERSION_FOR_API_DOCS: \"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "NUnit",
      "datasourceTemplate": "nuget"
    }
  ]
}
